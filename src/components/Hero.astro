---
// Replaces Starlight's Hero (astro.config.mjs → components). Same layout, but
// the image keeps its aspect ratio (Starlight renders it as a 400 × 400
// square, which crops the app window) and ships 1× and 2× sources, so the
// screenshot stays whole and sharp.
import { Image } from 'astro:assets';
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, image, actions = [] } = data.hero || {};
const file = image && 'file' in image ? image.file : image && 'dark' in image ? image.dark : undefined;
/** Width in CSS pixels; the 2× source must not be larger than the file. */
const width = file ? Math.min(600, Math.round(file.width / 2)) : 0;
---

<div class="lp-hero">
	{
		file && (
			<Image src={file} alt={image?.alt || ''} width={width} densities={[1, 2]} quality={90} loading="eager" decoding="async" class="lp-hero-image" />
		)
	}
	<div class="lp-hero-stack">
		<div class="lp-hero-copy">
			<h1 id="_top" data-page-title set:html={title} />
			{tagline && <div class="lp-hero-tagline" set:html={tagline} />}
		</div>
		{
			actions.length > 0 && (
				<div class="lp-hero-actions">
					{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link: href, text, variant }) => (
						<LinkButton {href} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
							{text}
							{icon?.html && <Fragment set:html={icon.html} />}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
</div>

<style is:global>
	.lp-hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2rem;
		padding-bottom: 1rem;
	}
	.lp-hero-image {
		display: block;
		width: min(100%, 36rem);
		height: auto;
		margin-inline: auto;
		border: 1px solid var(--lp-shot-border);
		border-radius: 14px;
		box-shadow: var(--lp-shot-shadow);
		background: var(--lp-stage-900);
	}
	.lp-hero-stack {
		display: flex;
		flex-direction: column;
		gap: clamp(1.5rem, calc(1.5rem + 1vw), 2rem);
		text-align: center;
	}
	.lp-hero-copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}
	.lp-hero-copy > * {
		max-width: 50ch;
	}
	.lp-hero h1 {
		font-size: clamp(var(--sl-text-3xl), calc(0.25rem + 5vw), var(--sl-text-6xl));
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.lp-hero-tagline {
		font-size: clamp(var(--sl-text-base), calc(0.0625rem + 2vw), var(--sl-text-xl));
		color: var(--sl-color-gray-2);
	}
	.lp-hero-actions {
		display: flex;
		gap: 1rem 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	@media (min-width: 50rem) {
		.lp-hero {
			grid-template-columns: 1fr 1fr;
			gap: 4%;
			padding-block: clamp(2.5rem, calc(1rem + 8vmin), 7rem);
		}
		.lp-hero-image {
			order: 2;
		}
		.lp-hero-stack {
			text-align: start;
		}
		.lp-hero-copy {
			align-items: flex-start;
		}
		.lp-hero-actions {
			justify-content: flex-start;
		}
	}
</style>
