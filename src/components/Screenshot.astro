---
// A screenshot from src/assets/screenshots/<name>.png, taken by `npm run screenshots`.
// Shots are captured at 2× and shown at their natural size in CSS pixels.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** path under src/assets/screenshots without ".png", e.g. "actions/playSound" */
	name: string;
	alt: string;
	caption?: string;
}

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/screenshots/**/*.png', { eager: true });
const { name, alt, caption } = Astro.props;
const shot = shots[`../assets/screenshots/${name}.png`]?.default;
---

{
	shot ? (
		<figure class="lp-figure">
			<Image src={shot} alt={alt} width={Math.round(shot.width / 2)} densities={[1, 2]} class="lp-shot" />
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : (
		<p class="lp-missing">
			Screenshot <code>{name}</code> is missing. Run <code>npm run screenshots -- {name.split('/').pop()}</code>.
		</p>
	)
}

<style>
	.lp-figure {
		margin-block: 1.25rem 1.75rem;
	}
	.lp-figure :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--lp-shot-border);
		border-radius: 14px;
		box-shadow: var(--lp-shot-shadow);
		background: var(--lp-stage-900);
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.lp-missing {
		padding: 1rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 14px;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}
</style>
